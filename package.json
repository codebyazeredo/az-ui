{
  "name": "az-ui",
  "version": "0.1.0",
  "description": "Component library and Design System for enterprise web applications, independent of frameworks.",
  "author": "Matheus Azeredo (codebyazeredo)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts/ibm-plex-sans.css": "./dist/fonts/ibm-plex-sans.css",
    "./fonts/source-sans-3.css": "./dist/fonts/source-sans-3.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "./dist/auto.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/generate-utilities.mjs",
    "prebuild": "npm run generate",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "pretest": "npm run generate",
    "test": "vitest run",
    "predev": "npm run generate",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
